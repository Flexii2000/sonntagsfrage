# Kopieren nach .env und Passwort setzen. .env ist in .gitignore.
DB_NAME=wahlen
DB_USER=wahlen
DB_PASSWORD=bitte-aendern
APP_PORT=8090
# Token fuer das Eintragen von Wahlabend-Staenden (Prognose, Hochrechnung).
# Erzeugen z.B. mit:  head -c 24 /dev/urandom | base64 | tr -d '/+='
WAHLABEND_TOKEN=bitte-setzen
